{
  "crons": [
    {
      "path": "/api/cron/minute",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/5min",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 23 * * 0"
    }
  ]
}
